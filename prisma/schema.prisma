generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  memberships    OrganizationMember[]
  savedPlaces    SavedPlace[]
  mapVersions    MapVersion[]
  organizations  Organization[] @relation("OrgOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Organizations ────────────────────────────────────────────────────────────

model Organization {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  logoUrl    String?
  ownerId    String
  visibility Visibility @default(PUBLIC)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id])
  members   OrganizationMember[]
  buildings Building[]
}

model OrganizationMember {
  id             String  @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole @default(VIEWER)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ─── Buildings ───────────────────────────────────────────────────────────────

model Building {
  id                 String         @id @default(cuid())
  organizationId     String
  name               String
  slug               String
  description        String?
  address            String?
  latitude           Float?
  longitude          Float?
  status             BuildingStatus @default(DRAFT)
  visibility         Visibility     @default(PUBLIC)
  mainEntranceNodeId String?
  imageUrl           String?
  category           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  floors        Floor[]
  nodes         Node[]
  edges         Edge[]
  qrCheckpoints QRCheckpoint[]
  savedPlaces   SavedPlace[]
  mapVersions   MapVersion[]

  @@unique([organizationId, slug])
}

model Floor {
  id                 String   @id @default(cuid())
  buildingId         String
  name               String
  levelNumber        Int
  description        String?
  floorPlanImageUrl  String?
  accessibilityNotes String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  building      Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  nodes         Node[]
  qrCheckpoints QRCheckpoint[]

  @@unique([buildingId, levelNumber])
}

// ─── Nodes & Edges ───────────────────────────────────────────────────────────

model Node {
  id                 String   @id @default(cuid())
  buildingId         String
  floorId            String
  name               String
  type               NodeType
  description        String?
  x                  Float    @default(100)
  y                  Float    @default(100)
  latitude           Float?
  longitude          Float?
  heading            Float?
  photoUrl           String?
  searchable         Boolean  @default(true)
  tags               String[]
  aliases            String[]
  accessibilityFlags String[]
  restricted         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  building      Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor         Floor          @relation(fields: [floorId], references: [id], onDelete: Cascade)
  edgesFrom     Edge[]         @relation("EdgeFrom")
  edgesTo       Edge[]         @relation("EdgeTo")
  qrCheckpoints QRCheckpoint[]
  savedPlaces   SavedPlace[]
}

model Edge {
  id               String  @id @default(cuid())
  buildingId       String
  fromNodeId       String
  toNodeId         String
  distanceEstimate Float?
  walkTimeEstimate Float?
  directionHint    String?
  accessible       Boolean @default(true)
  requiresStairs   Boolean @default(false)
  requiresElevator Boolean @default(false)
  requiresRamp     Boolean @default(false)
  restricted       Boolean @default(false)
  oneWay           Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  building  Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  fromNode  Node     @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode    Node     @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
}

// ─── QR & Saved ──────────────────────────────────────────────────────────────

model QRCheckpoint {
  id         String   @id @default(cuid())
  buildingId String
  floorId    String
  nodeId     String
  code       String   @unique @default(cuid())
  label      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor    Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  node     Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model SavedPlace {
  id         String   @id @default(cuid())
  userId     String
  buildingId String
  nodeId     String
  label      String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  node     Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
}

model MapVersion {
  id            String           @id @default(cuid())
  buildingId    String
  versionNumber Int
  status        MapVersionStatus @default(DRAFT)
  createdBy     String
  snapshotJson  Json?
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Visibility {
  PUBLIC
  PRIVATE
  ORG_ONLY
}

enum OrgRole {
  OWNER
  ADMIN
  MAPPER
  VIEWER
}

enum BuildingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NodeType {
  ENTRANCE
  EXIT
  RECEPTION
  HALLWAY_POINT
  CORRIDOR_JUNCTION
  DOOR
  ROOM
  OFFICE
  LECTURE_HALL
  RESTROOM
  STAIRCASE
  ELEVATOR
  RAMP
  LANDMARK
  RESTRICTED_AREA
  EMERGENCY_EXIT
}

enum MapVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
